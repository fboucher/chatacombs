# Copy to .env and change the secrets before going live.
# docker compose reads this file automatically.
# API_KEY: secret for your chat bot (Authorization: Bearer header). Can play and start/end adventures.
API_KEY=change-me-bot-secret
# OVERLAY_KEY: watch-only key for the OBS overlay URL (?key=). Use a different value from API_KEY.
OVERLAY_KEY=change-me-overlay-secret
BOT_NAME=Bones
# Link the bot posts when chat asks "Bones help". Empty = the players guide on GitHub.
HELP_URL=
PORT=8080
# Optional AI narrator (any OpenAI-compatible endpoint). Leave empty for template text.
# A model on this computer, e.g. Ollama: AI_URL=http://host.docker.internal:11434/v1
# (inside Docker, localhost is the container itself, not your computer)
AI_URL=
AI_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000
